{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=HexaTrack;Username=postgres;Password=root",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "HexaTrackAI",
    "Audience": "HexaTrackAI.Client",
    "SigningKey": "replace-with-at-least-32-characters-secret-key",
    "ExpiresMinutes": 60
  },
  "Google": {
    "ClientId": "replace-with-google-oauth-client-id.apps.googleusercontent.com"
  },
  "SuperAdmin": {
    "BootstrapEmails": []
  },
  "LoginThrottle": {
    "MaxFailuresPerWindow": 25,
    "WindowMinutes": 15,
    "SuspiciousFailureThreshold": 8
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://127.0.0.1:3000",
      "http://localhost:3001",
      "http://127.0.0.1:3001",
      "http://localhost:3002",
      "http://127.0.0.1:3002",
      "https://hexa-tracker.vercel.app",
      "https://*.vercel.app"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
